{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vericonomy Wallet (Alpha)",
  "version": "1.0.0-alpha.1",
  "identifier": "com.vericonomy.wallet.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build && npm run fetch:sidecars:if-missing",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Vericonomy Wallet (Alpha)",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "decorations": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: asset: http://ipc.localhost https://explorer-vrm.vericonomy.com https://explorer-vrc.vericonomy.com; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost; media-src 'self' blob:"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["verium", "vericoin"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "app", "appimage", "deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Finance",
    "shortDescription": "Vericonomy Wallet (Alpha)",
    "longDescription": "Modern desktop wallet for Verium (VRM) and Vericoin (VRC) with bundled veriumd and vericoind nodes, CPU mining, PoST staking, send/receive, transaction history, and chain bootstrap.",
    "publisher": "Vericonomy",
    "externalBin": ["binaries/veriumd", "binaries/vericoind"],
    "resources": [],
    "copyright": "Copyright (c) Vericonomy",
    "linux": {
      "deb": {
        "depends": []
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}
