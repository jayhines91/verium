{
  "name": "verium-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Modern Tauri + React desktop control UI for Verium core (veriumd).",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "node scripts/run-tauri-dev.cjs",
    "tauri:dev:raw": "tauri dev",
    "tauri:dev:msvc": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/tauri-dev.ps1",
    "tauri:build": "tauri build",
    "fetch:veriumd": "node scripts/fetch-veriumd.cjs",
    "fetch:veriumd:if-missing": "node scripts/fetch-veriumd.cjs --skip-if-present",
    "fetch:veriumd:stub": "node scripts/fetch-veriumd.cjs --stub --force",
    "lint": "tsc -b --pretty"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.59.16",
    "@tauri-apps/api": "^2.1.1",
    "@tauri-apps/plugin-dialog": "^2.0.1",
    "@tauri-apps/plugin-fs": "^2.0.3",
    "@tauri-apps/plugin-shell": "^2.0.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.27.0",
    "recharts": "^2.13.2",
    "tailwind-merge": "^2.5.4",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.1.0",
    "@types/node": "^25.9.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
