{
  "name": "vericonomy-app",
  "private": true,
  "version": "1.0.0-alpha.1",
  "type": "module",
  "description": "Modern Tauri + React desktop wallet for Verium (VRM) and Vericoin (VRC).",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "node scripts/run-tauri-dev.cjs",
    "tauri:dev:raw": "tauri dev",
    "tauri:dev:msvc": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/tauri-dev.ps1",
    "tauri:build": "tauri build",
    "tauri:build:msvc": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/tauri-build.ps1",
    "fetch:veriumd": "node scripts/fetch-veriumd.cjs",
    "fetch:veriumd:if-missing": "node scripts/fetch-veriumd.cjs --skip-if-present",
    "fetch:veriumd:stub": "node scripts/fetch-veriumd.cjs --stub --force",
    "fetch:vericoind": "node scripts/fetch-vericoind.cjs",
    "fetch:vericoind:if-missing": "node scripts/fetch-vericoind.cjs --skip-if-present",
    "fetch:vericoind:stub": "node scripts/fetch-vericoind.cjs --stub --force",
    "fetch:sidecars": "npm run fetch:veriumd && npm run fetch:vericoind",
    "fetch:sidecars:if-missing": "npm run fetch:veriumd:if-missing && npm run fetch:vericoind:if-missing",
    "fetch:sidecars:stub": "npm run fetch:veriumd:stub && npm run fetch:vericoind:stub",
    "fetch:sidecars:dace": "node scripts/fetch-dace-sidecars.cjs",
    "build:dace": "powershell -NoProfile -ExecutionPolicy Bypass -File ..\\..\\..\\vericoin\\build-dace.ps1",
    "lint": "tsc -b --pretty",
    "test": "vitest run",
    "test:watch": "vitest",
    "update:all": "ncu -u && npm install"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.100.14",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-deep-link": "^2.4.9",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "clsx": "^2.1.1",
    "lucide-react": "^1.17.0",
    "qr-scanner": "^1.4.2",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.16.0",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@tauri-apps/cli": "^2.11.2",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.5.0",
    "npm-check-updates": "^18.0.1",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.14",
    "vitest": "^4.1.7"
  }
}
